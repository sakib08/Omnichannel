# ── Version control ──────────────────────────────────────────────────────────
.git
.gitignore
.gitattributes

# ── This file ────────────────────────────────────────────────────────────────
.distignore

# ── Node / build tooling ─────────────────────────────────────────────────────
node_modules
package.json
package-lock.json
postcss.config.js
webpack.config.js

# ── Internal / editor tooling ────────────────────────────────────────────────
.agents
.codex
.cursor
.env
.env.*

# ── Build helpers (not needed at runtime) ────────────────────────────────────
bin

# ── Stale / empty directories ────────────────────────────────────────────────
# lang/ is superseded by languages/ — keep languages/, drop lang/
lang

# ── Distributables that must not be nested inside the release ZIP ────────────
*.zip

# NOTE: src/ is intentionally kept in the release.
# The human-readable React/JSX source is required by the GPLv2 for
# any compiled JavaScript shipped in build/. See readme.txt § "Source code".

# The "files" field in package.json is the inclusion list for wp-scripts plugin-zip.
# This .distignore file is kept for git/svn tooling and documents intent,
# but wp-scripts uses "files" when it is present.
